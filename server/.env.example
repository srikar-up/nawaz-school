# Server configuration. Copy to server/.env - it is git-ignored.
PORT=4000
# firestore | json
DATA_BACKEND=firestore

# Browser origins allowed to call the API, comma separated. The teacher app and
# the admin panel are separate deployments, so both must be listed.
# Local dev servers are allowed automatically when NODE_ENV is not production.
CORS_ORIGINS=https://teacher.example.com,https://admin.example.com

# Firebase Admin credentials (server only).
# Either point at the service-account JSON...
GOOGLE_APPLICATION_CREDENTIALS=
# ...or inline the whole JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary (server only). The secret signs uploads - never expose it to a browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: check ID-token revocation on every request (extra round trip).
AUTH_CHECK_REVOKED=false
