{
    "name":  "nawaz-school-server",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "Temporary shared data API for the teacher PWA and admin panel. Swap this layer for Firebase later.",
    "main":  "src/index.js",
    "scripts":  {
                    "start":  "node --env-file-if-exists=.env src/index.js",
                    "dev":  "node --env-file-if-exists=.env --watch src/index.js",
                    "seed":  "node --env-file-if-exists=.env src/seed-runner.js",
                    "test:db":  "node --test test/firestore.test.mjs",
                    "test:auth":  "node --test test/auth-mapping.test.mjs",
                    "test:attendance":  "node --test test/attendance-mode.test.mjs",
                    "test:attendance:api":  "node test/attendance-mode.e2e.mjs",
                    "test:attendance:ui":  "node test/attendance-ui.e2e.mjs",
                    "test:attendance:flow":  "node test/attendance-flow.e2e.mjs",
                    "test:polish":  "node test/polish-ui.e2e.mjs",
                    "test:photo":  "node test/photo-crop.e2e.mjs",
                    "test:curriculum":  "node --test test/curriculum.test.mjs",
                    "test:curriculum:api":  "node test/curriculum.e2e.mjs",
                    "test:curriculum:ui":  "node test/curriculum-ui.e2e.mjs",
                    "test:data-exchange":  "node test/data-exchange.e2e.mjs",
                    "create:users":  "node --env-file-if-exists=.env scripts/create-auth-users.mjs",
                    "test:google":  "node --env-file-if-exists=.env test/google-mapping.e2e.mjs",
                    "deploy":  "wrangler deploy --config wrangler.jsonc"
                },
    "dependencies":  {
                         "cors":  "^2.8.5",
                         "express":  "^4.21.2",
                         "firebase-admin":  "^14.5.0"
                     }
}
