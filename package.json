{
  "name": "nawaz-school-rms",
  "version": "1.0.0",
  "private": true,
  "description": "Nawaz School RMS — Teacher PWA + Admin Panel + temporary local Node/JSON data layer",
  "workspaces": [
    "server",
    "teacher-app",
    "admin-panel"
  ],
  "scripts": {
    "dev": "concurrently -n server,teacher,admin -c green,blue,magenta \"npm run dev:server\" \"npm run dev:teacher\" \"npm run dev:admin\"",
    "dev:server": "npm --workspace server run dev",
    "dev:teacher": "npm --workspace teacher-app run dev",
    "dev:admin": "npm --workspace admin-panel run dev",
    "start": "npm --workspace server run start",
    "seed": "npm --workspace server run seed",
    "build": "npm run build:teacher && npm run build:admin",
    "build:teacher": "npm --workspace teacher-app run build",
    "build:admin": "npm --workspace admin-panel run build",
    "preview": "npm run build && npm run start",
    "deploy:api": "npm --workspace server run deploy",
    "deploy:teacher": "npm --workspace teacher-app run deploy",
    "deploy:admin": "npm --workspace admin-panel run deploy",
    "test:api": "node server/smoke-test.mjs",
    "test:ui": "node server/ui-test.mjs",
    "test:db": "npm --workspace server run test:db",
    "test:auth": "npm --workspace server run test:auth",
    "test:attendance": "node --test server/test/attendance-mode.test.mjs",
    "test:attendance:api": "node server/test/attendance-mode.e2e.mjs",
    "test:attendance:ui": "node server/test/attendance-ui.e2e.mjs",
    "test:attendance:flow": "node server/test/attendance-flow.e2e.mjs",
    "test:polish": "node server/test/polish-ui.e2e.mjs",
    "test:photo": "node server/test/photo-crop.e2e.mjs",
    "test:curriculum": "node --test server/test/curriculum.test.mjs",
    "test:curriculum:api": "node server/test/curriculum.e2e.mjs",
    "test:curriculum:ui": "node server/test/curriculum-ui.e2e.mjs",
    "test:data-exchange": "node server/test/data-exchange.e2e.mjs",
    "test:assignments:api": "node server/test/assignment-access.e2e.mjs",
    "test:assignments:ui": "node server/test/assignment-ui.e2e.mjs",
    "test:csv-import": "node server/test/csv-import.e2e.mjs",
    "test:marks": "node server/test/marks-filters.e2e.mjs",
    "test:changes": "node --test server/test/change-tracking.test.mjs",
    "test:scale": "node --test server/test/scale.test.mjs",
    "test:maintenance": "node --test server/test/maintenance.test.mjs",
    "test:maintenance:api": "node server/test/maintenance.e2e.mjs",
    "test:delta": "node server/test/delta-sync.e2e.mjs",
    "test:state-patch": "node --test server/test/state-patch.test.mjs",
    "test:import-validation": "node --test server/test/import-validation.test.mjs",
    "test:load": "node server/scripts/load-test.mjs",
    "test:production": "node server/test/production.e2e.mjs"
  },
  "devDependencies": {
    "cf": "^0.15.0",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.65.0",
    "wrangler": "^4.160.0"
  }
}
