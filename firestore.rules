rules_version = '2';

// Nawaz School RMS - Firestore rules
//
// Architecture: the browser NEVER talks to Firestore. Both PWAs call the
// Express API, and the server reaches Firestore through the Firebase Admin SDK,
// which bypasses these rules entirely.
//
// So the correct client policy is: deny everything.
//
// The alternative role-based, client-facing rule set is kept in
// firestore.rules.client-access for reference only - do not publish both.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
