# Firebase web config - copy to .env.local and fill in.
# Values come from Firebase console -> Project settings -> Your apps -> Web app.
# These are PUBLIC by design: they only identify the project. Protect data with
# Firestore security rules and Firebase Auth, never by hiding these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Media uploads (Cloudinary - Firebase Storage is not used)
# Cloud name is public; the upload preset must be UNSIGNED for browser uploads.
VITE_CLOUDINARY_CLOUD_NAME=
